<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox id="background" alignment="CENTER" spacing="20" minHeight="700" minWidth="700" stylesheets="@application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.blogr.Controllers.SceneController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../icons/r.png" />
         </image>
      </ImageView>
      <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome to blogr">
         <font>
            <Font name="Chiller" size="32.0" />
         </font>
      </Text>
      <Button fx:id="signUpButton" mnemonicParsing="false" onAction="#switchToRegister" text="Sign Up" prefWidth="200"/>
      <Button fx:id="loginButton" mnemonicParsing="false" onAction="#switchToLogin" text="Log In" prefWidth="200"/>
   </children>
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>
</VBox>
