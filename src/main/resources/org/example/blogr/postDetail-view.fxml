<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox minHeight="700" minWidth="700" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.blogr.Controllers.PostDetailController">
    <AnchorPane id="secondary" stylesheets="@application.css">
        <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="5.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="10.0">
            <Image url="@../../../icons/r.png" />
        </ImageView>
        <FontIcon iconColor="#323437" iconLiteral="fas-home" iconSize="24" layoutX="18.0" layoutY="140.0" onMouseClicked="#switchToHome" wrappingWidth="23.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.6" AnchorPane.topAnchor="100.0" />
        <FontIcon iconColor="#323437" iconLiteral="fas-search" iconSize="24" layoutX="18.0" layoutY="197.0" onMouseClicked="#switchToSearch" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="150.0" />
        <FontIcon iconColor="#323437" iconLiteral="fas-plus" iconSize="24" layoutX="19.0" layoutY="246.0" onMouseClicked="#switchToAdd" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="26.200000000000003" AnchorPane.topAnchor="200.0" />
        <FontIcon iconColor="#323437" iconLiteral="fas-user-astronaut" iconSize="24" layoutX="19.0" layoutY="370.0" onMouseClicked="#switchToProfile" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" />
    </AnchorPane>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" HBox.hgrow="ALWAYS" xmlns:fx="http://javafx.com/fxml">

    <AnchorPane id="background" stylesheets="@application.css">

            <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" spacing="20">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                
                <!-- Action Buttons -->
                <HBox spacing="10">
                    <Button fx:id="backButton" mnemonicParsing="false" onAction="#switchToHome" text="Back" />
                    <Button fx:id="editButton" mnemonicParsing="false" onAction="#switchToEdit" text="Edit" />
                    <Button id="deleteButton" fx:id="deleteButton" mnemonicParsing="false" onAction="#deletePost" stylesheets="@application.css" text="Delete" textFill="WHITE" />
                </HBox>

                <!-- Post Header -->
                <VBox spacing="5">
                    <Label fx:id="postTitle" text="Post Title" styleClass="h1" wrapText="true"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="By:" styleClass="text"/>
                        <Label fx:id="authorName" text="Author name" styleClass="text" style="-fx-font-weight: bold;"/>
                        <Label text="|" styleClass="text"/>
                        <Label fx:id="dateCreated" text="Date Created" styleClass="text"/>
                        <Label text="|" styleClass="text"/>
                        <Label fx:id="lastUpdate" text="Last Update" styleClass="text"/>
                    </HBox>
                </VBox>

                <!-- Content -->
                <WebView fx:id="webView" focusTraversable="false" minHeight="400.0" prefHeight="-1" prefWidth="-1" VBox.vgrow="ALWAYS"/>

                <!-- Review Section -->
                <VBox fx:id="reviewPane" spacing="10" style="-fx-background-color: #252526; -fx-padding: 15; -fx-background-radius: 8;">
                    <Label text="Rate this post:" styleClass="h2"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Slider fx:id="ratingSlider" blockIncrement="0.5" majorTickUnit="1" max="5.0" min="0" value="5" showTickLabels="true" showTickMarks="true" snapToTicks="true" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="ratingValue" text="5.0" styleClass="text"/>
                    </HBox>
                    
                    <Label text="Add a comment:" styleClass="h2"/>
                    <TextArea fx:id="commentArea" prefHeight="80.0" promptText="Write your thoughts..." wrapText="true"/>
                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="sendReview" mnemonicParsing="false" onAction="#addReview" text="Post Comment" />
                    </HBox>
                </VBox>

                <!-- Comments List -->
                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="Comments" styleClass="h2"/>
                        <Label fx:id="commentCount" text="(0)" styleClass="text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Avg Rating:" styleClass="text"/>
                        <Label fx:id="avgRating" text="0.0" styleClass="text" style="-fx-font-weight: bold; -fx-text-fill: #4A90E2;"/>
                    </HBox>
                    <ListView fx:id="commentList" VBox.vgrow="ALWAYS" styleClass="list-view"/>
                </VBox>
            </VBox>

    </AnchorPane>
    </ScrollPane>
</HBox>
